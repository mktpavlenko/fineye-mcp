{
  "name": "fineye-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server (and CLI) for the FinEye personal-finance app — accounts, transactions, budgets and holdings, exposed to AI agents behind explicit safety gates.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fineye",
    "personal-finance",
    "cli",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mktpavlenko/fineye-mcp.git"
  },
  "type": "module",
  "bin": {
    "fineye": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ink": "^7.0.6",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
